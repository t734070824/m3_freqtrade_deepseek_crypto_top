{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "_comment": "M3-DSH 对照实验: 急跌反弹策略 (M3DipRevert)。与 config-dryrun.json 唯一的差别是策略名、数据库、日志与资金上限, 其余风控口径完全一致, 以保证两个 dry-run 可比。",
  "bot_name": "m3dsc-dip-dryrun",
  "initial_state": "running",
  "max_open_trades": 4,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.9,
  "available_capital": 500,
  "amend_last_stake_amount": true,
  "last_stake_amount_min_ratio": 0.2,
  "dry_run": true,
  "dry_run_wallet": 500,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.1,
  "timeframe": "5m",
  "strategy": "M3DipRevert",
  "minimal_roi": {},
  "stoploss": -0.2,
  "use_custom_stoploss": true,
  "position_adjustment_enable": false,
  "force_entry_enable": false,
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 0.8
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "stoploss": "market",
    "stoploss_on_exchange": false,
    "stoploss_price_type": "mark",
    "emergency_exit": "market",
    "force_exit": "market",
    "force_entry": "market"
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "unfilledtimeout": {
    "entry": 3,
    "exit": 5,
    "unit": "minutes"
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "options": {
        "defaultType": "swap"
      }
    },
    "ccxt_async_config": {
      "options": {
        "defaultType": "swap"
      }
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT"
    ],
    "pair_blacklist": [
      "BUSD/USDT:USDT",
      "USDC/USDT:USDT",
      "TUSD/USDT:USDT",
      "FDUSD/USDT:USDT",
      "DAI/USDT:USDT",
      "USDP/USDT:USDT",
      "EUR/USDT:USDT",
      "PAXG/USDT:USDT",
      "USD1/USDT:USDT",
      "XUSD/USDT:USDT",
      "BFUSD/USDT:USDT"
    ]
  },
  "pairlists": [
    {
      "_comment": "与主策略共用同一份候选池, 保证对照实验的标的集合一致",
      "method": "RemotePairList",
      "mode": "whitelist",
      "processing_mode": "append",
      "pairlist_url": "http://m3dsc-dashboard:8081/api/pairlist",
      "number_assets": 60,
      "refresh_period": 60,
      "keep_pairlist_on_failure": true,
      "read_timeout": 10
    },
    {
      "method": "SpreadFilter",
      "max_spread_ratio": 0.01,
      "refresh_period": 30
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 2,
      "refresh_period": 3600
    },
    {
      "method": "PriceFilter",
      "low_price_ratio": 0.3,
      "min_price": 0
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "enable_openapi": true,
    "jwt_secret_key": "m3dsc-dip-jwt-secret-overridden-by-env",
    "ws_token": "m3dsc-dip-ws-token-overridden",
    "CORS_origins": [
      "*"
    ],
    "username": "m3dsc",
    "password": "override-by-env-FREQTRADE__API_SERVER__PASSWORD"
  },
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  },
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",
  "logfile": "/workspace/logs/freqtrade-dip.log",
  "db_url": "sqlite:////freqtrade/user_data/m3dsc-dip.sqlite"
}
