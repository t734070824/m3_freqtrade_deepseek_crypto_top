# =====================================================================
# M3-DSH DeepSeek Crypto Top  (freqtrade + binance USD-M futures)
# 容器统一前缀: m3dsc
# 时间约定: 所有时间字段均显式标注 UTC 或 北京时间(UTC+8)
# =====================================================================

# 容器名/项目前缀 (唯一标记)
DSHC_PREFIX=m3dsc
DSHC_DATA_DIR=/home/dsh_3081/m3_freqtrade_deepseek_crypto_top/data
DSHC_LOG_DIR=/home/dsh_3081/m3_freqtrade_deepseek_crypto_top/logs
DSHC_UID=0

# ---- 网络 ----
# 直连 Binance 可用时留空; 若被墙则填 socks5h://127.0.0.1:10808
DSHC_PROXY=
# 场外数据源开关
DSHC_ENABLE_FNG=1
DSHC_ENABLE_NEWS=1
DSHC_ENABLE_ORDERBOOK=1
# 1=同时用 Binance 期货测试网公共数据做交叉校验(无需key)
DSHC_ENABLE_TESTNET=0

# ---- 采集频率(秒) ----
DSHC_INTERVAL_TICKER=60
DSHC_INTERVAL_MARK=60
DSHC_INTERVAL_OI=180
DSHC_INTERVAL_RATIO=300
DSHC_INTERVAL_FNG=900
DSHC_INTERVAL_NEWS=600
DSHC_INTERVAL_KLINES=300

# ---- 交易参数(供 freqtrade 生成配置) ----
DSHC_DRY_RUN_WALLET=1000
DSHC_MAX_OPEN_TRADES=6
DSHC_MAX_LEVERAGE=5
DSHC_STAKE_PER_TRADE_PCT=18

# ---- freqtrade REST API (dry-run 看板) ----
DSHC_FT_API_USER=m3dsc
DSHC_FT_API_PASS=change_me_m3dsc
DSHC_FT_API_PORT=18081
# 注意: 18082 已被同主机上另一个项目占用, 本项目看板使用 18083
DSHC_DASH_PORT=18083

# ---- 实盘用 Binance API Key (dry-run 无需, 留空即可) ----
# 注意: dry-run 模式完全不需要 key; 仅当切换到实盘时才填写, 且务必只开合约交易权限
DSHC_BINANCE_KEY=
DSHC_BINANCE_SECRET=
