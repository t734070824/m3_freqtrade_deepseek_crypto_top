# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- runtime data (large, regenerated) ----
# 运行时数据全部不入库: 时序库/候选池/日志均由容器自动重建
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
reports/

# ---- secrets ----
.env
*.secret
secrets/

# ---- freqtrade runtime ----
freqtrade/user_data/data/
freqtrade/user_data/logs/
freqtrade/user_data/backtest_results/
freqtrade/user_data/hyperopt_results/
*.sqlite
# ⚠️ 不要写裸的 "user_data/" —— 那会连带排除策略与测试代码
#    (2026-09-12 实际发生: 交易策略代码连续多次提交都没进仓库)
#    只忽略 freqtrade/user_data 下的运行时产物, strategies/ 与 tests/ 必须入库。
freqtrade/user_data/data/
freqtrade/user_data/logs/
freqtrade/user_data/backtest_results/
freqtrade/user_data/hyperopt_results/
freqtrade/user_data/plot/
freqtrade/user_data/notebooks/
freqtrade/user_data/*.sqlite*
freqtrade/user_data/*.json
freqtrade/user_data/__pycache__/

# ---- misc ----
.DS_Store
tmp/
*.pem
